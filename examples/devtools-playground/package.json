{
  "name": "@flexsurfer/reflex-devtools-playground",
  "version": "0.0.0",
  "private": true,
  "description": "Example app demonstrating Reflex Devtools",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:headless": "vite-node --watch src/headless.ts",
    "clean": "node ../../scripts/clean.mjs dist vite.config.js vite.config.d.ts tsconfig.tsbuildinfo tsconfig.node.tsbuildinfo",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "pnpm run typecheck && vite build",
    "check": "pnpm run typecheck",
    "preview": "vite preview"
  },
  "dependencies": {
    "@flexsurfer/reflex": "workspace:*",
    "@flexsurfer/reflex-devtools": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.2.0",
    "vite-node": "^6.0.0"
  }
}

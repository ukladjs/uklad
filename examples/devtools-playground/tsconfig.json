{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@flexsurfer/reflex-devtools": ["../../packages/reflex-devtools/src"],
      "@flexsurfer/reflex": ["../../packages/reflex/src"],
      "@flexsurfer/reflex/vanilla": ["../../packages/reflex/src/vanilla.ts"],
      "@flexsurfer/reflex/react": ["../../packages/reflex/src/react.ts"],
      "@flexsurfer/reflex/devtools": ["../../packages/reflex/src/devtools.ts"],
      "@flexsurfer/reflex/testing": ["../../packages/reflex/src/testing.ts"],
      "@flexsurfer/reflex/internal": ["../../packages/reflex/src/internal.ts"]
    }
  },
  "include": ["src"]
}

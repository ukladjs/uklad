{
  "name": "@ukladjs/devtools-playground",
  "version": "0.0.0",
  "private": true,
  "description": "Example app demonstrating Uklad Devtools",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:headless": "vite-node --watch src/headless.ts",
    "clean": "node ../../scripts/clean.mjs dist vite.config.js vite.config.d.ts tsconfig.tsbuildinfo tsconfig.node.tsbuildinfo",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "pnpm run typecheck && vite build",
    "check": "pnpm run typecheck",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ukladjs/core": "workspace:*",
    "@ukladjs/devtools": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.2.0",
    "vite-node": "^6.0.0"
  }
}

{
  "name": "@ukladjs/devtools-mcp",
  "version": "0.1.13",
  "description": "MCP server for Uklad DevTools - enables AI assistants to inspect traces and dispatch events",
  "author": "flexsurfer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ukladjs/uklad.git",
    "directory": "packages/devtools-mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "uklad-devtools-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node ../../scripts/clean.mjs dist",
    "build": "pnpm run clean && tsc",
    "test": "pnpm run build && pnpm run test:unit",
    "test:unit": "node --test test/*.test.mjs",
    "check": "pnpm run test:unit",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "keywords": [
    "mcp",
    "devtools",
    "debugging",
    "ai",
    "uklad",
    "model-context-protocol"
  ]
}

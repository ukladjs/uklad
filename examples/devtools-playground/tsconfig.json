{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@ukladjs/devtools": ["../../packages/devtools/src"],
      "@ukladjs/core": ["../../packages/core/src"],
      "@ukladjs/core/vanilla": ["../../packages/core/src/vanilla.ts"],
      "@ukladjs/core/react": ["../../packages/core/src/react.ts"],
      "@ukladjs/core/devtools": ["../../packages/core/src/devtools.ts"],
      "@ukladjs/core/testing": ["../../packages/core/src/testing.ts"],
      "@ukladjs/core/internal": ["../../packages/core/src/internal.ts"],
      "@ukladjs/tanstack-query": ["../../packages/tanstack-query/src/index.ts"]
    }
  },
  "include": ["src"]
}

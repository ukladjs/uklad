{
  "name": "@flexsurfer/reflex-devtools",
  "version": "0.1.16",
  "description": "Developer tools for applications built with the reflex library",
  "author": "flexsurfer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flexsurfer/reflex.git",
    "directory": "packages/reflex-devtools"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/client/index.js",
  "types": "dist/client/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    }
  },
  "bin": {
    "reflex-devtools": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "reflex_devtools_logo.jpg",
    "screenshot.png"
  ],
  "scripts": {
    "clean": "node ../../scripts/clean.mjs dist",
    "build": "pnpm --dir ../.. run build:devtools",
    "build:code": "tsc",
    "assemble:ui": "node scripts/assemble-ui.mjs",
    "build:package": "pnpm run clean && pnpm run build:code && pnpm run assemble:ui",
    "test": "pnpm run build && pnpm run test:unit",
    "typecheck:contract": "tsc --noEmit -p test/types/tsconfig.json",
    "test:unit": "pnpm run typecheck:contract && node --test test/*.test.mjs",
    "check": "pnpm run test:unit",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.12.1",
    "cors": "^2.8.5",
    "immer": "^10.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/ws": "^8.5.4",
    "@types/cors": "^2.8.13",
    "@types/node": "^20.8.0",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "devtools",
    "debugging",
    "react",
    "react-native",
    "reflex"
  ]
}

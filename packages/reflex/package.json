{
  "name": "@flexsurfer/reflex",
  "version": "0.1.26",
  "description": "Reflex (Reflex.js) — re-frame-style reactive state management for React and React Native. Pure event handlers over one central app-db, derived subscriptions, isolated side effects. Built for AI agentic development.",
  "license": "MIT",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || >=24.11.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flexsurfer/reflex.git",
    "directory": "packages/reflex"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla.d.mts",
        "default": "./dist/vanilla.mjs"
      },
      "require": {
        "types": "./dist/vanilla.d.cts",
        "default": "./dist/vanilla.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "llms.txt",
    "templates",
    "reflex_logo.jpg"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:compat": "tsc6 --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.jest.json",
    "lint": "eslint --max-warnings=0 src tests jest.config.mjs jest.setup.js tsdown.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run typecheck:compat && pnpm run typecheck:test && pnpm run build && pnpm run test:clean && pnpm run test:types && pnpm run test:types:dist && pnpm run test:types:package && pnpm run test:types:compat",
    "clean": "node ../../scripts/clean.mjs dist coverage",
    "dev": "tsdown --watch",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --passWithNoTests",
    "test:clean": "jest --passWithNoTests --silent",
    "test:watch": "jest --passWithNoTests --watch",
    "test:ci": "jest --passWithNoTests --coverage --silent",
    "test:types": "tsc --noEmit -p tests/types/tsconfig.json",
    "test:types:dist": "tsc --noEmit -p tests/types/dist/tsconfig.json",
    "test:types:package": "tsc --noEmit -p tests/types/package/tsconfig.json",
    "test:types:compat": "tsc6 --noEmit -p tests/types/package/tsconfig.json",
    "test:types:legacy": "node tests/legacy-consumer/run.js",
    "prepublishOnly": "pnpm run check && pnpm run test:ci"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "prettier": "3.9.5",
    "publint": "0.3.21",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ts-jest": "29.4.11",
    "tsdown": "0.22.8",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.64.0"
  },
  "dependencies": {
    "fast-deep-equal": "^3.1.3",
    "immer": "^11.1.11"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "reflex",
    "reflex.js",
    "re-frame",
    "state-management",
    "reactive",
    "event-driven",
    "subscriptions",
    "effects",
    "functional",
    "typescript",
    "react",
    "react-native",
    "unidirectional-data-flow",
    "frontend",
    "frp",
    "store",
    "pubsub",
    "handler"
  ]
}

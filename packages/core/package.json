{
  "name": "@ukladjs/core",
  "version": "0.2.4",
  "description": "Production-ready, agent-first state management for React and React Native. Stable public API, pure events, derived subscriptions, explicit effects, SSR, and verifiable DevTools.",
  "author": "flexsurfer",
  "license": "MIT",
  "homepage": "https://uklad.js.org",
  "bugs": {
    "url": "https://github.com/ukladjs/uklad/issues"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || >=24.11.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ukladjs/uklad.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "bin": {
    "uklad-agent": "dist/agent-cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla.d.mts",
        "default": "./dist/vanilla.mjs"
      },
      "require": {
        "types": "./dist/vanilla.d.cts",
        "default": "./dist/vanilla.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./devtools": {
      "import": {
        "types": "./dist/devtools.d.mts",
        "default": "./dist/devtools.mjs"
      },
      "require": {
        "types": "./dist/devtools.d.cts",
        "default": "./dist/devtools.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.mts",
        "default": "./dist/internal.mjs"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "templates"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:compat": "tsc6 --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.jest.json",
    "lint": "eslint --max-warnings=0 src tests benchmarks jest.config.mjs jest.setup.js tsdown.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run typecheck:compat && pnpm run typecheck:test && pnpm run build && pnpm run test:clean && pnpm run test:types && pnpm run test:types:dist && pnpm run test:types:package && pnpm run test:types:compat",
    "check:package": "pnpm run test:types:legacy",
    "clean": "node ../../scripts/clean.mjs dist coverage",
    "dev": "tsdown --watch",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --passWithNoTests",
    "test:clean": "jest --passWithNoTests --silent",
    "test:watch": "jest --passWithNoTests --watch",
    "test:ci": "jest --passWithNoTests --coverage --silent",
    "test:types": "tsc --noEmit -p tests/types/tsconfig.json",
    "test:types:dist": "tsc --noEmit -p tests/types/dist/tsconfig.json",
    "test:types:package": "tsc --noEmit -p tests/types/package/tsconfig.json",
    "test:types:compat": "tsc6 --noEmit -p tests/types/package/tsconfig.json",
    "test:types:legacy": "node tests/legacy-consumer/run.js",
    "benchmark": "pnpm run build && node --expose-gc benchmarks/run.mjs",
    "benchmark:state": "pnpm run build && node --expose-gc benchmarks/run.mjs state",
    "benchmark:equality": "pnpm run build && node --expose-gc benchmarks/run.mjs equality",
    "benchmark:subscriptions": "pnpm run build && node --expose-gc benchmarks/run.mjs subscriptions",
    "benchmark:events": "pnpm run build && node --expose-gc benchmarks/run.mjs events",
    "benchmark:effects": "pnpm run build && NODE_ENV=production node --expose-gc benchmarks/run.mjs effects",
    "benchmark:effects:dev": "pnpm run build && NODE_ENV=development node --expose-gc benchmarks/run.mjs effects",
    "benchmark:effects:compare": "pnpm run build && NODE_ENV=production node --expose-gc benchmarks/run.mjs effects && NODE_ENV=development node --expose-gc benchmarks/run.mjs effects",
    "benchmark:memory": "pnpm run build && node --expose-gc benchmarks/run.mjs memory",
    "prepublishOnly": "pnpm run check && pnpm run check:package && pnpm run test:ci"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-jest": "29.4.12",
    "tsdown": "0.22.14",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.68.0"
  },
  "dependencies": {
    "immer": "^11.1.15"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "uklad",
    "uklad.js",
    "re-frame",
    "state-management",
    "production-ready",
    "ai-agent",
    "agentic-development",
    "mcp",
    "redux-alternative",
    "zustand-alternative",
    "reactive",
    "event-driven",
    "subscriptions",
    "effects",
    "functional",
    "typescript",
    "react",
    "react-native",
    "unidirectional-data-flow",
    "frontend",
    "frp",
    "store",
    "pubsub",
    "handler"
  ]
}

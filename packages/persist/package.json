{
  "name": "@ukladjs/persist",
  "version": "0.1.0",
  "description": "Synchronous persistence for Uklad.",
  "author": "flexsurfer",
  "license": "MIT",
  "sideEffects": false,
  "homepage": "https://uklad.js.org",
  "bugs": {
    "url": "https://github.com/ukladjs/uklad/issues"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || >=24.11.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ukladjs/uklad.git",
    "directory": "packages/persist"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:compat": "tsc6 --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.jest.json",
    "lint": "eslint --max-warnings=0 src tests tsdown.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run typecheck:compat && pnpm run typecheck:test && pnpm run build && pnpm run test",
    "check:package": "pnpm run test:package",
    "clean": "node ../../scripts/clean.mjs dist coverage",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --passWithNoTests",
    "test:ci": "jest --passWithNoTests --coverage --silent",
    "test:package": "node tests/package-consumer/run.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run check && pnpm run check:package && pnpm run test:ci"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@eslint/js": "10.0.1",
    "@ukladjs/core": "workspace:*",
    "@types/jest": "30.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "jest": "30.4.2",
    "prettier": "3.9.6",
    "publint": "0.3.23",
    "ts-jest": "29.4.12",
    "tsdown": "0.22.14",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.67.0"
  },
  "peerDependencies": {
    "@ukladjs/core": "^0.2.0"
  },
  "keywords": [
    "uklad",
    "uklad.js",
    "persistence",
    "localStorage",
    "hydration",
    "state-management",
    "re-frame"
  ]
}

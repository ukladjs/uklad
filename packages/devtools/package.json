{
  "name": "@ukladjs/devtools",
  "version": "0.2.0",
  "description": "Developer tools for applications built with Uklad.",
  "author": "flexsurfer",
  "license": "MIT",
  "homepage": "https://uklad.js.org",
  "bugs": {
    "url": "https://github.com/ukladjs/uklad/issues"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ukladjs/uklad.git",
    "directory": "packages/devtools"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "dist/client/index.js",
  "types": "dist/client/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    }
  },
  "bin": {
    "uklad-devtools": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "uklad-avatar.png",
    "uklad-avatar-dark.png",
    "screenshot.png"
  ],
  "scripts": {
    "clean": "node ../../scripts/clean.mjs dist",
    "build": "pnpm --dir ../.. run build:devtools",
    "build:code": "tsc",
    "assemble:ui": "node scripts/assemble-ui.mjs",
    "build:package": "pnpm run clean && pnpm run build:code && pnpm run assemble:ui",
    "test": "pnpm run build && pnpm run test:unit",
    "typecheck:contract": "tsc --noEmit -p test/types/tsconfig.json",
    "test:unit": "pnpm run typecheck:contract && node --test test/*.test.mjs",
    "check": "pnpm run test:unit",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "express": "^5.2.1",
    "immer": "^11.1.15",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@ukladjs/core": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "keywords": [
    "devtools",
    "debugging",
    "react",
    "react-native",
    "uklad"
  ]
}
